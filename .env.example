# Example environment variables for Digi-Kaufvertrag
# Copy to .env and edit values for your environment

# Application
NODE_ENV=development
PORT=5000

# CORS: set to your frontend origin (or comma-separated list)
# In development you can use http://localhost:5173 (Vite default)
CORS_ORIGIN=http://localhost:5173

# CSP: allowed connect-src entries for sockets/API requests (comma-separated).
# The server will always include 'self' and append these values.
# Example: allow local dev and the deployed frontend origin
CSP_CONNECT_SRC=http://localhost:5173,https://digi-kaufvertrag-production.up.railway.app

# Database (optional): example for Postgres or leave blank to use local sqlite
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# JWT secret (set in production)
JWT_SECRET=replace_with_a_strong_secret
